<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/filter_nav"
	app:startDestination="@id/products">

	<fragment
		android:id="@+id/products"
		android:name="com.zarinfanavaran.presentation.filter.FilterProductsFragment"
		android:label="FilterProductsFragment"
		tools:layout="@layout/fragment_filter_products">
		<argument
			android:name="categoryDetail"
			android:defaultValue="@null"
			app:argType="com.zarinfanavaran.domain.models.CategoryDetail"
			app:nullable="true" />
		<argument
			android:name="category"
			android:defaultValue="@null"
			app:argType="com.zarinfanavaran.domain.models.Category"
			app:nullable="true" />
		<argument
			android:name="brand"
			android:defaultValue="@null"
			app:argType="com.zarinfanavaran.domain.models.Brand"
			app:nullable="true" />
		<argument
			android:name="sortOption"
			android:defaultValue="@null"
			app:argType="com.zarinfanavaran.domain.models.SortOption"
			app:nullable="true" />
		<action
			android:id="@+id/action_products_to_filterFiltersDialogFragment"
			app:destination="@id/filterFiltersDialogFragment" />
	</fragment>

	<dialog
		android:id="@+id/filterFiltersDialogFragment"
		android:name="com.zarinfanavaran.presentation.filter.FilterFiltersDialogFragment"
		android:label="FilterFiltersDialogFragment"
		tools:layout="@layout/fragment_dialog_filter_filters" />
</navigation>