<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	>

	<androidx.coordinatorlayout.widget.CoordinatorLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent">

		<com.google.android.material.appbar.AppBarLayout
			android:id="@+id/appbarId"
			android:layout_width="match_parent"
			android:layout_height="wrap_content">

			<com.google.android.material.appbar.MaterialToolbar
				android:id="@+id/toolbarId"
				android:layout_width="match_parent"
				android:layout_height="wrap_content">

				<androidx.constraintlayout.widget.ConstraintLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content">

					<androidx.appcompat.widget.AppCompatImageView
						android:id="@+id/imgToolbarIcon"
						style="@style/ToolbarStyle.Image"
						android:layout_width="wrap_content"
						android:layout_height="@dimen/_34sdp"
						android:src="@drawable/ic_arrow_right"
						app:layout_constraintBottom_toBottomOf="parent"
						app:layout_constraintStart_toStartOf="parent"
						app:layout_constraintTop_toTopOf="parent" />

					<com.google.android.material.textview.MaterialTextView
						android:id="@+id/txtToolbarTitle"
						style="@style/ToolbarStyle.Text"
						android:layout_width="0dp"
						android:layout_height="0dp"
						android:text="@string/add_edit_address"
						app:layout_constraintBottom_toBottomOf="@id/imgToolbarIcon"
						app:layout_constraintEnd_toEndOf="parent"
						app:layout_constraintStart_toEndOf="@id/imgToolbarIcon"
						app:layout_constraintTop_toTopOf="@id/imgToolbarIcon" />

				</androidx.constraintlayout.widget.ConstraintLayout>

			</com.google.android.material.appbar.MaterialToolbar>

		</com.google.android.material.appbar.AppBarLayout>

		<androidx.constraintlayout.widget.ConstraintLayout
			android:id="@+id/clMain"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

			<FrameLayout
				android:id="@+id/flMap"
				android:layout_width="0dp"
				android:layout_height="0dp"
				app:layout_constraintBottom_toTopOf="@id/flBottom"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toTopOf="parent" />

			<androidx.appcompat.widget.AppCompatImageView
				android:layout_width="@dimen/_40sdp"
				android:layout_height="@dimen/_40sdp"
				android:scaleType="fitEnd"
				android:src="@drawable/ic_marker"
				app:layout_constraintBottom_toTopOf="@id/mapMiddle"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:tint="@color/color42" />

			<View
				android:id="@+id/mapMiddle"
				android:layout_width="0dp"
				android:layout_height="1dp"
				android:visibility="invisible"
				app:layout_constraintBottom_toBottomOf="@id/flMap"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toTopOf="@id/flMap" />

			<com.google.android.material.card.MaterialCardView
				android:id="@+id/cvSearchMap"
				android:layout_width="0dp"
				android:layout_height="@dimen/_36sdp"
				android:layout_marginStart="@dimen/_16sdp"
				android:layout_marginTop="@dimen/_16sdp"
				android:layout_marginEnd="@dimen/_16sdp"
				android:elevation="0dp"
				app:cardCornerRadius="0dp"
				app:cardElevation="0dp"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toTopOf="parent"
				app:strokeColor="@color/color18"
				app:strokeWidth="@dimen/_1sdp">

				<com.google.android.material.textview.MaterialTextView
					android:id="@+id/txtSearchMap"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:gravity="center_vertical"
					android:paddingStart="@dimen/_16sdp"
					android:paddingEnd="@dimen/_16sdp"
					android:text="@string/search_in_map"
					android:textColor="@color/colorA3"
					android:textSize="@dimen/_9ssp" />

			</com.google.android.material.card.MaterialCardView>

			<com.google.android.material.button.MaterialButton
				android:id="@+id/btnZoomIn"
				style="@style/Widget.Material3.Button.Icon"
				android:layout_width="@dimen/_23sdp"
				android:layout_height="@dimen/_23sdp"
				android:layout_marginTop="@dimen/_26sdp"
				android:insetTop="0dp"
				android:insetBottom="0dp"
				android:padding="0dp"
				app:backgroundTint="@color/colorFB"
				app:cornerRadius="@dimen/_5sdp"
				app:icon="@drawable/ic_add_rounded"
				app:iconGravity="textStart"
				app:iconPadding="0dp"
				app:iconTint="@color/color6F"
				app:layout_constraintEnd_toEndOf="@id/cvSearchMap"
				app:layout_constraintTop_toBottomOf="@id/cvSearchMap"
				app:strokeColor="@color/colorE3"
				app:strokeWidth="@dimen/_1sdp" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/btnZoomOut"
				style="@style/Widget.Material3.Button.Icon"
				android:layout_width="@dimen/_23sdp"
				android:layout_height="@dimen/_23sdp"
				android:layout_marginTop="@dimen/_8sdp"
				android:insetTop="0dp"
				android:insetBottom="0dp"
				android:padding="0dp"
				app:backgroundTint="@color/colorFB"
				app:cornerRadius="@dimen/_5sdp"
				app:icon="@drawable/ic_minus_rounded"
				app:iconGravity="textStart"
				app:iconPadding="0dp"
				app:iconTint="@color/color6F"
				app:layout_constraintEnd_toEndOf="@id/cvSearchMap"
				app:layout_constraintTop_toBottomOf="@id/btnZoomIn"
				app:strokeColor="@color/colorE3"
				app:strokeWidth="@dimen/_1sdp" />

			<com.google.android.material.floatingactionbutton.FloatingActionButton
				android:id="@+id/btnMyLocation"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginStart="@dimen/_16sdp"
				android:layout_marginBottom="@dimen/_16sdp"
				android:contentDescription="@string/my_location"
				android:src="@drawable/ic_my_location"
				app:backgroundTint="@color/colorFB"
				app:layout_constraintBottom_toTopOf="@id/flBottom"
				app:layout_constraintStart_toStartOf="parent"
				app:tint="@color/color6F" />


			<FrameLayout
				android:id="@+id/flBottom"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				app:layout_constraintBottom_toBottomOf="parent"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent">

				<androidx.appcompat.widget.AppCompatImageView
					android:layout_width="match_parent"
					android:layout_height="@dimen/_8sdp"
					android:scaleType="fitXY"
					android:src="@drawable/gradient_bottom_shopcart" />

				<FrameLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="@dimen/_8sdp"
					android:background="@color/white"
					android:paddingStart="@dimen/_16sdp"
					android:paddingTop="@dimen/_9sdp"
					android:paddingEnd="@dimen/_16sdp"
					android:paddingBottom="@dimen/_9sdp">

					<com.google.android.material.button.MaterialButton
						android:id="@+id/btnNext"
						android:layout_width="match_parent"
						android:layout_height="@dimen/_36sdp"
						android:insetTop="0dp"
						android:insetBottom="0dp"
						android:padding="0dp"
						android:text="@string/select_point_on_map"
						android:textAppearance="@style/TextAppearance.FontMedium"
						android:textColor="@color/colorEF"
						android:textSize="@dimen/_11ssp"
						app:cornerRadius="0dp" />
				</FrameLayout>
			</FrameLayout>


		</androidx.constraintlayout.widget.ConstraintLayout>

	</androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>