<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools">

	<data>

		<import type="android.view.View" />

		<variable
			name="user"
			type="com.zarinfanavaran.domain.models.User" />
	</data>

	<androidx.coordinatorlayout.widget.CoordinatorLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent">

		<com.google.android.material.appbar.AppBarLayout
			android:id="@+id/appbarId"
			android:layout_width="match_parent"
			android:layout_height="wrap_content">

			<com.google.android.material.appbar.MaterialToolbar
				android:id="@+id/toolbarId"
				android:layout_width="match_parent"
				android:layout_height="wrap_content">

				<androidx.constraintlayout.widget.ConstraintLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content">

					<androidx.appcompat.widget.AppCompatImageView
						android:id="@+id/imgToolbarIcon"
						style="@style/ToolbarStyle.Image"
						android:layout_width="wrap_content"
						android:layout_height="@dimen/_34sdp"
						android:src="@drawable/ic_arrow_right"
						app:layout_constraintBottom_toBottomOf="parent"
						app:layout_constraintStart_toStartOf="parent"
						app:layout_constraintTop_toTopOf="parent" />

					<com.google.android.material.textview.MaterialTextView
						android:id="@+id/txtToolbarTitle"
						style="@style/ToolbarStyle.Text"
						android:layout_width="0dp"
						android:layout_height="0dp"
						android:text="@string/edit_user_information"
						app:layout_constraintBottom_toBottomOf="@id/imgToolbarIcon"
						app:layout_constraintEnd_toEndOf="parent"
						app:layout_constraintStart_toEndOf="@id/imgToolbarIcon"
						app:layout_constraintTop_toTopOf="@id/imgToolbarIcon" />

				</androidx.constraintlayout.widget.ConstraintLayout>

			</com.google.android.material.appbar.MaterialToolbar>

		</com.google.android.material.appbar.AppBarLayout>

		<FrameLayout
			android:id="@+id/flMain"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

			<androidx.core.widget.NestedScrollView
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:contentDescription="@string/editinfoscrollview"
				android:fillViewport="true">

				<androidx.appcompat.widget.LinearLayoutCompat
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:clipToPadding="false"
					android:orientation="vertical"
					android:paddingTop="@dimen/_10sdp"
					android:paddingBottom="@dimen/_15sdp">

					<androidx.constraintlayout.widget.ConstraintLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content">

						<com.google.android.material.imageview.ShapeableImageView
							android:id="@+id/imgProfile"
							android:layout_width="@dimen/_100sdp"
							android:layout_height="@dimen/_100sdp"
							android:padding="@dimen/_1sdp"
							android:scaleType="centerCrop"
							android:src="@drawable/temp_profile"
							app:layout_constraintEnd_toEndOf="parent"
							app:layout_constraintStart_toStartOf="parent"
							app:layout_constraintTop_toTopOf="parent"
							app:shapeAppearance="@style/ProfileImageEdit"
							app:strokeColor="@color/color42"
							app:strokeWidth="@dimen/_2sdp" />

						<com.google.android.material.imageview.ShapeableImageView
							android:id="@+id/btnEditImage"
							android:layout_width="@dimen/_28sdp"
							android:layout_height="@dimen/_28sdp"
							android:background="@color/color42"
							android:scaleType="centerInside"
							android:src="@drawable/ic_edit_stroke"
							app:layout_constraintBottom_toBottomOf="@id/imgProfile"
							app:layout_constraintEnd_toEndOf="@id/imgProfile"
							app:shapeAppearance="@style/ProfileImage"
							app:shapeAppearanceOverlay="@style/EditCircle"
							app:tint="@color/white" />

					</androidx.constraintlayout.widget.ConstraintLayout>

					<androidx.appcompat.widget.LinearLayoutCompat
						android:layout_width="match_parent"
						android:layout_height="@dimen/_45sdp"
						android:layout_marginStart="@dimen/_20sdp"
						android:layout_marginTop="@dimen/_15sdp"
						android:layout_marginEnd="@dimen/_20sdp"
						android:background="@color/white"
						android:gravity="center_vertical"
						android:orientation="horizontal"
						android:padding="@dimen/_10sdp">

						<com.google.android.material.button.MaterialButton
							android:id="@+id/txtMobile"
							style="@style/Widget.MaterialComponents.Button.TextButton"
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_marginEnd="@dimen/_10sdp"
							android:layout_weight="1"
							android:clickable="false"
							android:enabled="false"
							android:gravity="start|center_vertical"
							android:insetTop="0dp"
							android:insetBottom="0dp"
							android:padding="0dp"
							android:text="@string/sample_mobile_edit"
							android:textAlignment="viewStart"
							android:textColor="@color/color18"
							android:textSize="@dimen/_10ssp"
							app:icon="@drawable/ic_phone_stroke"
							app:iconTint="@color/color18"
							tools:ignore="TouchTargetSizeCheck" />

						<com.google.android.material.textview.MaterialTextView
							android:layout_width="wrap_content"
							android:layout_height="@dimen/_25sdp"
							android:background="@color/color42"
							android:gravity="center"
							android:paddingStart="@dimen/_10sdp"
							android:paddingEnd="@dimen/_10sdp"
							android:text="@string/confirmed"
							android:textColor="@color/colorF1"
							android:textSize="@dimen/_10ssp" />

					</androidx.appcompat.widget.LinearLayoutCompat>

					<androidx.appcompat.widget.LinearLayoutCompat
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginStart="@dimen/_20sdp"
						android:layout_marginTop="@dimen/_15sdp"
						android:layout_marginEnd="@dimen/_20sdp"
						android:background="@color/white"
						android:orientation="vertical"
						android:paddingStart="@dimen/_10sdp"
						android:paddingTop="@dimen/_12sdp"
						android:paddingEnd="@dimen/_10sdp"
						android:paddingBottom="@dimen/_20sdp"
						android:visibility="visible">

						<FrameLayout
							android:layout_width="match_parent"
							android:layout_height="wrap_content">

							<com.google.android.material.button.MaterialButton
								style="@style/Widget.MaterialComponents.Button.TextButton"
								android:layout_width="wrap_content"
								android:layout_height="@dimen/_24sdp"
								android:clickable="false"
								android:enabled="false"
								android:gravity="start|center_vertical"
								android:insetTop="0dp"
								android:insetBottom="0dp"
								android:padding="0dp"
								android:text="@string/account"
								android:textAlignment="viewStart"
								android:textAppearance="@style/TextAppearance.FontSemiBold"
								android:textColor="@color/color18"
								android:textSize="@dimen/_12ssp"
								app:icon="@drawable/ic_contact_stroke"
								app:iconPadding="@dimen/_5sdp"
								app:iconTint="@color/color18" />

							<androidx.appcompat.widget.AppCompatImageView
								android:id="@+id/btnEditInfo"
								android:layout_width="@dimen/_24sdp"
								android:layout_height="@dimen/_24sdp"
								android:layout_gravity="end"
								android:scaleType="fitCenter"
								android:src="@drawable/ic_edit_stroke" />
						</FrameLayout>

						<androidx.appcompat.widget.LinearLayoutCompat
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="@dimen/_10sdp"
							android:background="@color/colorEF"
							android:orientation="vertical"
							android:padding="@dimen/_10sdp">

							<com.google.android.material.textview.MaterialTextView
								android:layout_width="match_parent"
								android:layout_height="@dimen/_25sdp"
								android:gravity="center_vertical"
								android:text="@string/first_name"
								android:textColor="@color/color18"
								android:textSize="@dimen/_12ssp" />

							<View
								android:layout_width="match_parent"
								android:layout_height="@dimen/_2sdp"
								android:layout_marginTop="@dimen/_10sdp"
								android:layout_marginBottom="@dimen/_10sdp"
								android:background="@color/white" />

							<com.google.android.material.textview.MaterialTextView
								android:layout_width="match_parent"
								android:layout_height="@dimen/_25sdp"
								android:gravity="center_vertical"
								android:text="@{user.firstName, default=`@string/sample_first_name`}"
								android:textAppearance="@style/TextAppearance.FontMedium"
								android:textColor="@color/color18"
								android:textSize="@dimen/_12ssp" />

						</androidx.appcompat.widget.LinearLayoutCompat>

						<androidx.appcompat.widget.LinearLayoutCompat
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="@dimen/_10sdp"
							android:background="@color/colorEF"
							android:orientation="vertical"
							android:padding="@dimen/_10sdp">

							<com.google.android.material.textview.MaterialTextView
								android:layout_width="match_parent"
								android:layout_height="@dimen/_25sdp"
								android:gravity="center_vertical"
								android:text="@string/last_name"
								android:textColor="@color/color18"
								android:textSize="@dimen/_12ssp" />

							<View
								android:layout_width="match_parent"
								android:layout_height="@dimen/_2sdp"
								android:layout_marginTop="@dimen/_10sdp"
								android:layout_marginBottom="@dimen/_10sdp"
								android:background="@color/white" />

							<com.google.android.material.textview.MaterialTextView
								android:layout_width="match_parent"
								android:layout_height="@dimen/_25sdp"
								android:gravity="center_vertical"
								android:text="@{user.lastName, default=`@string/sample_last_name`}"
								android:textAppearance="@style/TextAppearance.FontMedium"
								android:textColor="@color/color18"
								android:textSize="@dimen/_12ssp" />

						</androidx.appcompat.widget.LinearLayoutCompat>

						<androidx.appcompat.widget.LinearLayoutCompat
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="@dimen/_10sdp"
							android:background="@color/colorEF"
							android:orientation="vertical"
							android:padding="@dimen/_10sdp">

							<com.google.android.material.textview.MaterialTextView
								android:layout_width="match_parent"
								android:layout_height="@dimen/_25sdp"
								android:gravity="center_vertical"
								android:text="@string/personal_code"
								android:textColor="@color/color18"
								android:textSize="@dimen/_12ssp" />

							<View
								android:layout_width="match_parent"
								android:layout_height="@dimen/_2sdp"
								android:layout_marginTop="@dimen/_10sdp"
								android:layout_marginBottom="@dimen/_10sdp"
								android:background="@color/white" />

							<com.google.android.material.textview.MaterialTextView
								android:layout_width="match_parent"
								android:layout_height="@dimen/_25sdp"
								android:gravity="center_vertical|end"
								android:text="@{user.nationalCode, default=`@string/sample_personal_code`}"
								android:textAlignment="viewEnd"
								android:textAppearance="@style/TextAppearance.FontMedium"
								android:textColor="@color/color18"
								android:textSize="@dimen/_12ssp" />

						</androidx.appcompat.widget.LinearLayoutCompat>
					</androidx.appcompat.widget.LinearLayoutCompat>

					<androidx.appcompat.widget.LinearLayoutCompat
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginStart="@dimen/_20sdp"
						android:layout_marginTop="@dimen/_15sdp"
						android:layout_marginEnd="@dimen/_20sdp"
						android:background="@color/white"
						android:orientation="vertical"
						android:paddingStart="@dimen/_10sdp"
						android:paddingTop="@dimen/_12sdp"
						android:paddingEnd="@dimen/_10sdp"
						android:paddingBottom="@dimen/_20sdp"
						android:visibility="visible">

						<com.google.android.material.button.MaterialButton
							style="@style/Widget.MaterialComponents.Button.TextButton"
							android:layout_width="wrap_content"
							android:layout_height="@dimen/_24sdp"
							android:clickable="false"
							android:enabled="false"
							android:gravity="start|center_vertical"
							android:insetTop="0dp"
							android:insetBottom="0dp"
							android:padding="0dp"
							android:text="@string/extra_info"
							android:textAlignment="viewStart"
							android:textAppearance="@style/TextAppearance.FontSemiBold"
							android:textColor="@color/color18"
							android:textSize="@dimen/_12ssp"
							app:icon="@drawable/ic_contact_stroke"
							app:iconPadding="@dimen/_5sdp"
							app:iconTint="@color/color18" />

						<androidx.appcompat.widget.LinearLayoutCompat
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="@dimen/_10sdp"
							android:background="@color/colorEF"
							android:orientation="vertical"
							android:padding="@dimen/_10sdp">

							<FrameLayout
								android:layout_width="match_parent"
								android:layout_height="@dimen/_25sdp">

								<com.google.android.material.textview.MaterialTextView
									android:layout_width="wrap_content"
									android:layout_height="match_parent"
									android:layout_gravity="start"
									android:gravity="center_vertical"
									android:text="@string/birthdate"
									android:textColor="@color/color18"
									android:textSize="@dimen/_14ssp" />

								<androidx.appcompat.widget.AppCompatImageView
									android:id="@+id/btnEditBirthDay"
									android:layout_width="@dimen/_25sdp"
									android:layout_height="@dimen/_25sdp"
									android:layout_gravity="end|center_vertical"
									android:scaleType="fitCenter"
									android:src="@drawable/ic_edit_stroke" />

							</FrameLayout>

							<View
								android:layout_width="match_parent"
								android:layout_height="@dimen/_2sdp"
								android:layout_marginTop="@dimen/_10sdp"
								android:layout_marginBottom="@dimen/_10sdp"
								android:background="@color/white" />

							<com.google.android.material.textview.MaterialTextView
								android:layout_width="match_parent"
								android:layout_height="@dimen/_25sdp"
								android:gravity="center_vertical"
								android:letterSpacing="0.1"
								android:text="@{user.jalaliBornAt, default=`@string/_7_dash`}"
								android:textColor="@color/color42"
								android:textSize="@dimen/_14ssp" />

						</androidx.appcompat.widget.LinearLayoutCompat>

						<androidx.appcompat.widget.LinearLayoutCompat
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="@dimen/_12sdp"
							android:background="@color/colorEF"
							android:orientation="vertical"
							android:padding="@dimen/_10sdp">

							<FrameLayout
								android:layout_width="match_parent"
								android:layout_height="@dimen/_25sdp">

								<androidx.appcompat.widget.LinearLayoutCompat
									android:layout_width="wrap_content"
									android:layout_height="match_parent">

									<com.google.android.material.textview.MaterialTextView
										android:layout_width="wrap_content"
										android:layout_height="match_parent"
										android:gravity="center_vertical"
										android:text="@string/email"
										android:textColor="@color/color18"
										android:textSize="@dimen/_14ssp" />

									<com.google.android.material.textview.MaterialTextView
										android:layout_width="wrap_content"
										android:layout_height="match_parent"
										android:layout_marginStart="@dimen/_10sdp"
										android:background="@{user.emailConfirmed ? @color/color42 : @color/colorD6, default=`@color/colorD6`}"
										android:gravity="center_vertical"
										android:paddingStart="@dimen/_10sdp"
										android:paddingEnd="@dimen/_10sdp"
										android:text="@{user.emailConfirmed ? @string/confirmed : @string/not_confirmed, default=`@string/not_confirmed`}"
										android:textColor="@color/colorF1"
										android:textSize="@dimen/_10ssp"
										android:visibility="@{user.email.isEmpty() ? View.GONE : View.VISIBLE}" />

								</androidx.appcompat.widget.LinearLayoutCompat>

								<androidx.appcompat.widget.AppCompatImageView
									android:id="@+id/btnEditEmail"
									android:layout_width="@dimen/_25sdp"
									android:layout_height="@dimen/_25sdp"
									android:layout_gravity="end|center_vertical"
									android:scaleType="fitCenter"
									android:src="@drawable/ic_edit_stroke" />

							</FrameLayout>

							<View
								android:layout_width="match_parent"
								android:layout_height="@dimen/_2sdp"
								android:layout_marginTop="@dimen/_10sdp"
								android:layout_marginBottom="@dimen/_10sdp"
								android:background="@color/white" />

							<com.google.android.material.textview.MaterialTextView
								android:layout_width="match_parent"
								android:layout_height="@dimen/_25sdp"
								android:gravity="center_vertical|end"
								android:text="@{user.email, default=`@string/sample_email`}"
								android:textAlignment="viewEnd"
								android:textColor="@color/color42"
								android:textSize="@dimen/_14ssp" />

						</androidx.appcompat.widget.LinearLayoutCompat>
					</androidx.appcompat.widget.LinearLayoutCompat>

					<androidx.appcompat.widget.LinearLayoutCompat
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginStart="@dimen/_20sdp"
						android:layout_marginTop="@dimen/_15sdp"
						android:layout_marginEnd="@dimen/_20sdp"
						android:background="@color/white"
						android:orientation="vertical"
						android:paddingStart="@dimen/_10sdp"
						android:paddingTop="@dimen/_12sdp"
						android:paddingEnd="@dimen/_10sdp"
						android:paddingBottom="@dimen/_20sdp">

						<com.google.android.material.button.MaterialButton
							style="@style/Widget.MaterialComponents.Button.TextButton"
							android:layout_width="wrap_content"
							android:layout_height="@dimen/_24sdp"
							android:clickable="false"
							android:enabled="false"
							android:gravity="start|center_vertical"
							android:insetTop="0dp"
							android:insetBottom="0dp"
							android:padding="0dp"
							android:text="@string/bank_info"
							android:textAlignment="viewStart"
							android:textAppearance="@style/TextAppearance.FontSemiBold"
							android:textColor="@color/color18"
							android:textSize="@dimen/_12ssp"
							app:icon="@drawable/ic_bank_stroke"
							app:iconPadding="@dimen/_5sdp"
							app:iconTint="@color/color18" />

						<androidx.appcompat.widget.LinearLayoutCompat
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:layout_marginTop="@dimen/_10sdp"
							android:orientation="vertical">

							<com.google.android.material.button.MaterialButton
								android:id="@+id/btnAddBankAccount"
								style="@style/Widget.MaterialComponents.Button.TextButton"
								android:layout_width="match_parent"
								android:layout_height="@dimen/_47sdp"
								android:gravity="center"
								android:insetTop="0dp"
								android:insetBottom="0dp"
								android:padding="0dp"
								android:text="@string/add_bank_account"
								android:textColor="@color/colorA3"
								android:textSize="@dimen/_14ssp"
								app:backgroundTint="@color/colorEF"
								app:cornerRadius="0dp"
								app:elevation="0dp"
								app:icon="@drawable/ic_add_stroke"
								app:iconGravity="textStart"
								app:iconPadding="@dimen/_10sdp"
								app:iconSize="@dimen/_24sdp"
								app:iconTint="@color/colorA3" />

							<com.google.android.material.textview.MaterialTextView
								android:id="@+id/txtEmptyCreditCards"
								android:layout_width="match_parent"
								android:layout_height="@dimen/_40sdp"
								android:layout_marginTop="@dimen/_10sdp"
								android:background="@color/colorEF"
								android:gravity="center"
								android:text="@string/no_bank_account"
								android:textColor="@color/color22"
								android:textSize="@dimen/_12ssp"
								android:visibility="gone" />

							<androidx.recyclerview.widget.RecyclerView
								android:id="@+id/rvCreditCards"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
								tools:itemCount="2"
								tools:listitem="@layout/template_bank_account_item" />

						</androidx.appcompat.widget.LinearLayoutCompat>
					</androidx.appcompat.widget.LinearLayoutCompat>

				</androidx.appcompat.widget.LinearLayoutCompat>
			</androidx.core.widget.NestedScrollView>
		</FrameLayout>

		<View
			android:layout_width="match_parent"
			android:layout_height="@dimen/_10sdp"
			android:layout_gravity="bottom"
			android:background="@drawable/gradient_bottom_white" />

	</androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>