<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools">

	<androidx.coordinatorlayout.widget.CoordinatorLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:layoutDirection="locale"
		tools:context=".filter.FilterProductsFragment">

		<com.google.android.material.appbar.AppBarLayout
			android:id="@+id/appbarId"
			android:layout_width="match_parent"
			android:layout_height="wrap_content">

			<com.google.android.material.appbar.MaterialToolbar
				android:id="@+id/toolbarId"
				android:layout_width="match_parent"
				android:layout_height="wrap_content">

				<androidx.constraintlayout.widget.ConstraintLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content">

					<androidx.appcompat.widget.AppCompatImageView
						android:id="@+id/imgToolbarIcon"
						style="@style/ToolbarStyle.Image"
						android:layout_width="wrap_content"
						android:layout_height="@dimen/_34sdp"
						android:src="@drawable/ic_arrow_right"
						app:layout_constraintBottom_toBottomOf="parent"
						app:layout_constraintStart_toStartOf="parent"
						app:layout_constraintTop_toTopOf="parent" />

					<com.google.android.material.textview.MaterialTextView
						android:id="@+id/txtToolbarTitle"
						style="@style/ToolbarStyle.Text"
						android:layout_width="0dp"
						android:layout_height="0dp"
						android:text="@string/search_in_lumex_shop"
						app:layout_constraintBottom_toBottomOf="@id/imgToolbarIcon"
						app:layout_constraintEnd_toEndOf="parent"
						app:layout_constraintStart_toEndOf="@id/imgToolbarIcon"
						app:layout_constraintTop_toTopOf="@id/imgToolbarIcon" />

				</androidx.constraintlayout.widget.ConstraintLayout>

			</com.google.android.material.appbar.MaterialToolbar>

		</com.google.android.material.appbar.AppBarLayout>

		<androidx.constraintlayout.widget.ConstraintLayout
			android:id="@+id/clMain"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">
<!--			<androidx.swiperefreshlayout.widget.SwipeRefreshLayout-->
<!--				xmlns:android="http://schemas.android.com/apk/res/android"-->
<!--				android:id="@+id/swiperefresh"-->
<!--				android:layout_width="match_parent"-->
<!--				android:layout_height="match_parent">-->
<!--			</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>-->

			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/rvProducts"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:clipToPadding="false"
				android:paddingTop="@dimen/_14sdp"
				android:paddingBottom="@dimen/_12sdp"
				app:layout_constraintBottom_toTopOf="@id/filters"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toTopOf="parent"
				tools:listitem="@layout/template_filter_product_item" />

			<View
				android:id="@+id/gradientBottom"
				android:layout_width="0dp"
				android:layout_height="@dimen/_10sdp"
				android:background="@drawable/gradient_bottom_white"
				app:layout_constraintBottom_toTopOf="@id/filters"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent" />

			<FrameLayout
				android:id="@+id/filters"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:background="@color/white"
				app:layout_constraintBottom_toBottomOf="parent"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent">

				<androidx.constraintlayout.widget.ConstraintLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content">

					<com.google.android.material.button.MaterialButton
						android:id="@+id/btnFilters"
						style="@style/Widget.MaterialComponents.Button.TextButton"
						android:layout_width="wrap_content"
						android:layout_height="@dimen/_23sdp"
						android:layout_marginStart="@dimen/_16sdp"
						android:layout_marginTop="@dimen/_16sdp"
						android:layout_marginBottom="@dimen/_16sdp"
						android:gravity="center"
						android:insetLeft="0dp"
						android:insetTop="0dp"
						android:insetRight="0dp"
						android:insetBottom="0dp"
						android:padding="0dp"
						android:text="@string/filters"
						android:textColor="@color/color18"
						android:textSize="@dimen/_9ssp"
						app:cornerRadius="0dp"
						app:icon="@drawable/ic_filters_stroke"
						app:iconGravity="textStart"
						app:iconPadding="@dimen/_4sdp"
						app:iconSize="@dimen/_18sdp"
						app:iconTint="@color/color18"
						app:layout_constraintBottom_toBottomOf="parent"
						app:layout_constraintStart_toStartOf="parent"
						app:layout_constraintTop_toTopOf="parent"
						app:rippleColor="@color/transparent" />

					<com.google.android.material.button.MaterialButton
						android:id="@+id/btnSort"
						style="@style/Widget.MaterialComponents.Button.TextButton"
						android:layout_width="wrap_content"
						android:layout_height="@dimen/_23sdp"
						android:layout_marginStart="@dimen/_16sdp"
						android:layout_marginTop="@dimen/_16sdp"
						android:layout_marginBottom="@dimen/_16sdp"
						android:gravity="center"
						android:insetLeft="0dp"
						android:insetTop="0dp"
						android:insetRight="0dp"
						android:insetBottom="0dp"
						android:padding="0dp"
						android:text="@string/most_viewed"
						android:textColor="@color/color18"
						android:textSize="@dimen/_9ssp"
						app:cornerRadius="0dp"
						app:icon="@drawable/ic_descending_stroke"
						app:iconGravity="textStart"
						app:iconPadding="@dimen/_4sdp"
						app:iconSize="@dimen/_18sdp"
						app:iconTint="@color/color18"
						app:layout_constraintBottom_toBottomOf="parent"
						app:layout_constraintStart_toEndOf="@id/btnFilters"
						app:layout_constraintTop_toTopOf="parent"
						app:rippleColor="@color/transparent" />

					<com.google.android.material.button.MaterialButton
						android:id="@+id/btnShare"
						style="@style/Widget.Material3.Button.IconButton"
						android:layout_width="wrap_content"
						android:layout_height="@dimen/_23sdp"
						android:layout_marginTop="@dimen/_16sdp"
						android:layout_marginEnd="@dimen/_16sdp"
						android:layout_marginBottom="@dimen/_16sdp"
						android:gravity="center"
						android:insetLeft="0dp"
						android:insetTop="0dp"
						android:insetRight="0dp"
						android:insetBottom="0dp"
						android:padding="0dp"
						app:cornerRadius="0dp"
						app:icon="@drawable/ic_share_filled"
						app:iconSize="@dimen/_18sdp"
						app:iconTint="@color/color18"
						app:layout_constraintBottom_toBottomOf="parent"
						app:layout_constraintEnd_toEndOf="parent"
						app:layout_constraintTop_toTopOf="parent"
						app:rippleColor="@color/transparent" />

				</androidx.constraintlayout.widget.ConstraintLayout>
			</FrameLayout>

		</androidx.constraintlayout.widget.ConstraintLayout>
	</androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>