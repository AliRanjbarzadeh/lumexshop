<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	>

	<data>

		<variable
			name="item"
			type="com.zarinfanavaran.domain.models.Intro" />
	</data>

	<androidx.constraintlayout.widget.ConstraintLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:layoutDirection="locale">

		<androidx.constraintlayout.widget.Guideline
			android:id="@+id/glIntro"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			app:layout_constraintGuide_percent="0.7" />

		<androidx.appcompat.widget.AppCompatImageView
			android:id="@+id/imgIntro"
			android:layout_width="0dp"
			android:layout_height="0dp"
			android:scaleType="fitEnd"
			app:layout_constraintBottom_toBottomOf="@id/glIntro"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toTopOf="parent" />

		<com.google.android.material.button.MaterialButton
			android:layout_width="wrap_content"
			android:layout_height="@dimen/_29sdp"
			android:layout_marginTop="@dimen/_11sdp"
			android:contentDescription="@string/app_name"
			android:insetTop="0dp"
			android:insetBottom="0dp"
			android:paddingStart="@dimen/_12sdp"
			android:paddingEnd="@dimen/_12sdp"
			android:text="@{item.btnText}"
			android:textAppearance="@style/TextAppearance.FontSemiBold"
			android:textColor="@color/colorF1"
			android:textSize="@dimen/_9ssp"
			app:cornerRadius="0dp"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toTopOf="parent" />

		<androidx.appcompat.widget.AppCompatTextView
			android:id="@+id/txtIntroTitle"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/_minus12sdp"
			android:layout_marginStart="@dimen/_18sdp"
			android:layout_marginEnd="@dimen/_18sdp"
			android:gravity="start|center_vertical"
			android:text="@{item.title}"
			android:textAlignment="viewStart"
			android:textAppearance="@style/TextAppearance.FontSemiBold"
			android:textSize="@dimen/_11ssp"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toTopOf="@id/glIntro" />

		<androidx.appcompat.widget.AppCompatTextView
			android:id="@+id/txtIntroDescription"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:gravity="start|center_vertical"
			android:text="@{item.description}"
			android:textAlignment="viewStart"
			android:textColor="@color/color18"
			android:textSize="@dimen/_9ssp"
			app:layout_constraintEnd_toEndOf="@id/txtIntroTitle"
			app:layout_constraintStart_toStartOf="@id/txtIntroTitle"
			app:layout_constraintTop_toBottomOf="@id/txtIntroTitle" />

	</androidx.constraintlayout.widget.ConstraintLayout>
</layout>