<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools">

	<androidx.constraintlayout.widget.ConstraintLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:layoutDirection="locale"
		tools:context=".MainActivity">

		<androidx.fragment.app.FragmentContainerView
			android:id="@+id/base_nav_host"
			android:name="androidx.navigation.fragment.NavHostFragment"
			android:layout_width="0dp"
			android:layout_height="0dp"
			app:defaultNavHost="true"
			app:layout_constraintBottom_toTopOf="@id/clMenu"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toTopOf="parent"
			app:navGraph="@navigation/base_nav"
			tools:layout="@layout/fragment_home" />

		<androidx.constraintlayout.widget.ConstraintLayout
			android:id="@+id/clMenu"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			app:layout_constraintBottom_toBottomOf="parent"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent">

			<com.blure.complexview.ComplexView
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_margin="0dp"
				android:paddingStart="0dp"
				android:paddingTop="@dimen/_2sdp"
				android:paddingEnd="0dp"
				android:paddingBottom="0dp"
				app:gradientAngle="bottom_top"
				app:gradientEndColor="@color/blackT"
				app:gradientType="linear"
				app:layout_constraintBottom_toBottomOf="parent"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:shadow="false">

				<com.google.android.material.bottomnavigation.BottomNavigationView
					android:id="@+id/bottomMenu"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:elevation="0dp"
					app:elevation="0dp"
					app:itemRippleColor="@color/white"
					app:itemTextAppearanceActive="@style/BottomMenuTextAppearanceActive"
					app:itemTextAppearanceInactive="@style/BottomMenuTextAppearance"
					app:itemTextColor="@color/bottom_menu_color"
					app:labelVisibilityMode="labeled"
					app:menu="@menu/bottom_menu" />
			</com.blure.complexview.ComplexView>

		</androidx.constraintlayout.widget.ConstraintLayout>

		<com.blure.complexview.ComplexView
			android:id="@+id/middleButtonShadow"
			android:layout_width="@dimen/_62sdp"
			android:layout_height="@dimen/_62sdp"
			android:contentDescription="@string/app_name"
			app:layout_constraintBottom_toTopOf="@id/clMenu"
			app:layout_constraintEnd_toEndOf="@id/clMenu"
			app:layout_constraintStart_toStartOf="@id/clMenu"
			app:layout_constraintTop_toTopOf="@id/clMenu"
			app:radius="@dimen/_28sdp"
			app:shadow="true"
			app:shadowPosition="top"
			app:shadowSpread="2" />

		<com.google.android.material.imageview.ShapeableImageView
			android:id="@+id/middleButton"
			android:layout_width="@dimen/_56sdp"
			android:layout_height="@dimen/_56sdp"
			android:background="@drawable/fab_bottom_menu"
			android:scaleType="center"
			android:src="@drawable/ic_sale_stroke"
			app:layout_constraintBottom_toTopOf="@id/clMenu"
			app:layout_constraintEnd_toEndOf="@id/clMenu"
			app:layout_constraintStart_toStartOf="@id/clMenu"
			app:layout_constraintTop_toTopOf="@id/clMenu"
			tools:ignore="ImageContrastCheck" />

	</androidx.constraintlayout.widget.ConstraintLayout>
</layout>