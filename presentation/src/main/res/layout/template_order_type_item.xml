<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto">

	<data>

		<import type="android.view.View" />

		<variable
			name="item"
			type="com.zarinfanavaran.domain.models.OrderType" />
	</data>

	<com.google.android.material.card.MaterialCardView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginStart="@dimen/_4sdp"
		android:layout_marginEnd="@dimen/_4sdp"
		app:cardBackgroundColor="@color/white"
		app:cardCornerRadius="0dp"
		app:cardElevation="0dp"
		app:strokeWidth="0dp">

		<androidx.constraintlayout.widget.ConstraintLayout
			android:layout_width="@dimen/_92sdp"
			android:layout_height="wrap_content"
			android:paddingBottom="@dimen/_8sdp">

			<androidx.appcompat.widget.AppCompatImageView
				android:id="@+id/imgOrderType"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:layout_margin="@dimen/_8sdp"
				android:scaleType="fitCenter"
				android:src="@drawable/temp_umbrella"
				app:layout_constraintDimensionRatio="50:23"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toTopOf="parent" />

			<com.google.android.material.textview.MaterialTextView
				android:id="@+id/txtBadge"
				android:layout_width="@dimen/_9sdp"
				android:layout_height="@dimen/_9sdp"
				android:background="@drawable/bg_badge_bottom_menu"
				android:gravity="center"
				android:padding="0dp"
				android:text="@{item.badgeCountString, default=`@string/sample_badge_count`}"
				android:textAppearance="@style/TextAppearance.FontSemiBold"
				android:textColor="@color/colorF1"
				android:textSize="@dimen/_5ssp"
				android:visibility="@{item.badgeCount > 0 ? View.VISIBLE : View.INVISIBLE}"
				app:layout_constraintEnd_toEndOf="@id/imgOrderType"
				app:layout_constraintTop_toTopOf="@id/imgOrderType" />

			<com.google.android.material.textview.MaterialTextView
				android:id="@+id/txtTitle"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/_8sdp"
				android:ellipsize="end"
				android:gravity="center"
				android:maxLines="1"
				android:minLines="1"
				android:text="@{item.title, default=`@string/sample_order_type`}"
				android:textAlignment="center"
				android:textColor="@color/color18"
				android:textSize="@dimen/_8ssp"
				app:layout_constraintEnd_toEndOf="@id/imgOrderType"
				app:layout_constraintStart_toStartOf="@id/imgOrderType"
				app:layout_constraintTop_toBottomOf="@id/imgOrderType" />

		</androidx.constraintlayout.widget.ConstraintLayout>
	</com.google.android.material.card.MaterialCardView>
</layout>
