<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto">

	<data>

		<variable
			name="item"
			type="com.zarinfanavaran.domain.models.Filter" />
	</data>

	<androidx.appcompat.widget.LinearLayoutCompat
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@color/colorEF"
		android:orientation="vertical">

		<androidx.constraintlayout.widget.ConstraintLayout
			android:id="@+id/clFilterTitle"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="@dimen/_8sdp">

			<com.google.android.material.textview.MaterialTextView
				android:id="@+id/txtFilterTitle"
				android:layout_width="0dp"
				android:layout_height="0dp"
				android:layout_marginEnd="@dimen/_8sdp"
				android:text="@{item.name, default=`@string/sample_filter_title`}"
				android:textColor="@color/color18"
				android:textSize="@dimen/_9ssp"
				app:layout_constraintBottom_toBottomOf="parent"
				app:layout_constraintEnd_toStartOf="@id/flSwitch"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toTopOf="parent" />

			<FrameLayout
				android:id="@+id/flSwitch"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				app:layout_constraintBottom_toBottomOf="parent"
				app:layout_constraintEnd_toEndOf="parent"
				app:layout_constraintTop_toTopOf="parent">

				<com.google.android.material.switchmaterial.SwitchMaterial
					android:id="@+id/btnSwitch"
					android:layout_width="@dimen/_24sdp"
					android:layout_height="@dimen/_12sdp"
					android:background="@null"
					android:checked="@{item.selected}"
					android:clickable="false"
					android:enabled="false"
					android:layoutDirection="ltr"
					android:thumb="@drawable/ic_switch_thumb"
					app:showText="false"
					app:switchMinWidth="@dimen/_24sdp"
					app:switchPadding="0dp"
					app:thumbTextPadding="0dp"
					app:track="@drawable/ic_switch"
					app:useMaterialThemeColors="false" />
			</FrameLayout>

		</androidx.constraintlayout.widget.ConstraintLayout>

	</androidx.appcompat.widget.LinearLayoutCompat>
</layout>